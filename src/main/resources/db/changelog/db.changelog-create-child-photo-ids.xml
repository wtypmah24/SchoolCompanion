<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="3-create-child-photo-ids-table" author="wtypmah">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="child_photo_ids"/>
            </not>
        </preConditions>
        <createTable tableName="child_photo_ids">
            <column name="photo_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="child_id" type="BIGINT"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="child_photo_ids"
                baseColumnNames="child_id"
                constraintName="fk_goal_child"
                referencedTableName="children"
                referencedColumnNames="id"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
