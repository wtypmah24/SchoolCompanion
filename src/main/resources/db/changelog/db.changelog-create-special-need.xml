<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2-create-special-need-table" author="wtypmah">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="special_needs"/>
            </not>
        </preConditions>
        <createTable tableName="special_needs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="child_id" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="special_needs"
                baseColumnNames="child_id"
                constraintName="fk_special_need_child"
                referencedTableName="children"
                referencedColumnNames="id"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="CASCADE"/>
    </changeSet>



</databaseChangeLog>
