<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1-create-children-table" author="wtypmah">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="children"/>
            </not>
        </preConditions>
        <createTable tableName="children">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="surname" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(50)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="active" type="BOOLEAN" defaultValue="true"/>
            <column name="companion_id" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="children"
                baseColumnNames="companion_id"
                constraintName="fk_child_companion"
                referencedTableName="companions"
                referencedColumnNames="id"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>
