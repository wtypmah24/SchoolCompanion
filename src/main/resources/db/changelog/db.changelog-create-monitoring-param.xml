<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1-create-monitoring-parameter-table" author="wtypmah">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="monitoring_parameters"/>
            </not>
        </preConditions>
        <createTable tableName="monitoring_parameters">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="type" type="scale_type"/>
            <column name="description" type="TEXT"/>
            <column name="companion_id" type="BIGINT"/>
            <column name="min_value" type="INTEGER"/>
            <column name="max_value" type="INTEGER"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="monitoring_parameters"
                baseColumnNames="companion_id"
                constraintName="fk_monitoring_parameter_companion"
                referencedTableName="companions"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>
