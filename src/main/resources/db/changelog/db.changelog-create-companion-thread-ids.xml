<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="3-create-companion-thread-ids-table" author="wtypmah">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="companion-thread-ids"/>
            </not>
        </preConditions>
        <createTable tableName="companion_thread_ids">
            <column name="thread_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="companion_id" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="companion_thread_ids"
                baseColumnNames="companion_id"
                constraintName="fk_thread_companion"
                referencedTableName="companions"
                referencedColumnNames="id"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
