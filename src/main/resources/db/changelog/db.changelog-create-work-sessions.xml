<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1-create-work-sessions" author="wtypmah">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="work_sessions"/>
            </not>
        </preConditions>
        <createTable tableName="work_sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="start_time" type="TIMESTAMP"/>
            <column name="end_time" type="TIMESTAMP"/>
            <column name="note" type="VARCHAR(255)"/>
            <column name="companion_id" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="work_sessions"
                baseColumnNames="companion_id"
                constraintName="fk_worksession_companion"
                referencedTableName="companions"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex
                indexName="idx_worksession_companion_id"
                tableName="work_sessions">
            <column name="companion_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
